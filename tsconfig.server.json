{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "rootDir": "server",
    "outDir": "server-build",
    "sourceMap": true
  },
  "include": ["server/index.ts"]
}
